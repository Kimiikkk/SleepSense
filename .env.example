# Copy this file to .env and set your Firebase project values.
FIREBASE_ENABLED=true
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=

# Store the service-account JSON outside this repository and reference its path here.
# Leave blank when Application Default Credentials are available in the runtime.
# On Windows, use forward slashes (C:/Users/...) or escape backslashes (C:\\Users\\...).
FIREBASE_SERVICE_ACCOUNT_PATH=

# Optional external AI Sleep Coach. Keep the key on the server only.
AI_PROVIDER=none
AI_API_KEY=
AI_API_BASE_URL=https://api.openai.com/v1/responses
AI_MODEL=gpt-4.1-mini
AI_TIMEOUT_SECONDS=12

# Optional Smart Sleep Score weight overrides; missing measurements are omitted, not zeroed.
SLEEPSENSE_SCORE_WEIGHT_DURATION=25
SLEEPSENSE_SCORE_WEIGHT_DEEP=15
SLEEPSENSE_SCORE_WEIGHT_REM=15
SLEEPSENSE_SCORE_WEIGHT_AWAKE=10
SLEEPSENSE_SCORE_WEIGHT_EFFICIENCY=15
SLEEPSENSE_SCORE_WEIGHT_CONSISTENCY=10
SLEEPSENSE_SCORE_WEIGHT_HEART_RATE=10
SLEEPSENSE_SCORE_MAX_WITH_MISSING_CORE=84
SLEEPSENSE_SCORE_MAX_WITHOUT_CONSISTENCY=92
