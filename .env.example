# Copy this file to .env and set your Firebase project values.
FIREBASE_ENABLED=true
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=

# Store the service-account JSON outside this repository and reference its path here.
# Leave blank when Application Default Credentials are available in the runtime.
# On Windows, use forward slashes (C:/Users/...) or escape backslashes (C:\\Users\\...).
FIREBASE_SERVICE_ACCOUNT_PATH=
